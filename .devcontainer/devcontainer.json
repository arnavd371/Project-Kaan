{
  "name": "Project Kaan",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "web/README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; cd web && npm install; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "bash -lc 'cd web && npm run dev -- --hostname 0.0.0.0 --port 3000'"
  },
  "portsAttributes": {
    "3000": {
      "label": "Kaan web",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000
  ]
}
